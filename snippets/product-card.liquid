{%- comment -%}
  snippets/product-card.liquid — the single product card used everywhere.

  Extracted from templates/index.liquid so the homepage, collection pages and
  search results cannot drift apart. Change the card here and it changes
  everywhere.

  Usage:
    {%- render 'product-card', product: product -%}
    {%- render 'product-card', product: product, show_vendor: true -%}
{%- endcomment -%}

<div class="product-card">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 700 }}"
          srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w"
          sizes="(min-width: 990px) 25vw, 50vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}">
        {%- if product.images.size > 1 -%}
          <img
            src="{{ product.images[1] | image_url: width: 700 }}"
            alt=""
            loading="lazy"
            class="product-card__media-hover">
        {%- endif -%}
      {%- else -%}
        {%- render 'paavai-placeholder', title: product.title -%}
      {%- endif -%}
    </a>

    {%- comment -%} Karat badge — the first thing a gold buyer checks. {%- endcomment -%}
    {%- if product.tags contains '24kt-gold' -%}
      <span class="badge badge--karat">24KT</span>
    {%- elsif product.tags contains '22kt-gold' -%}
      <span class="badge badge--karat">22KT</span>
    {%- elsif product.tags contains '18kt-gold' -%}
      <span class="badge badge--karat">18KT</span>
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <span class="badge badge--sale">Sale</span>
    {%- endif -%}

    <button
      type="button"
      class="wishlist-btn"
      data-wishlist-toggle
      data-product-handle="{{ product.handle }}"
      aria-pressed="false"
      aria-label="Save {{ product.title | escape }} to wishlist">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.2l7.7-7.7 1.1-1.1a5.5 5.5 0 0 0 0-7.8Z"></path></svg>
    </button>

    <button
      type="button"
      class="quick-view-btn"
      data-quick-view-btn
      data-product-url="{{ product.url }}.js"
      aria-label="Quick view {{ product.title | escape }}">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
    </button>

    {%- form 'product', product, class: 'product-card__form product-card__quick-add-form' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button
        type="submit"
        name="add"
        class="quick-add-btn"
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {%- if product.selected_or_first_available_variant.available -%}
          <span>Quick Add</span>
        {%- else -%}
          <span>Enquire</span>
        {%- endif -%}
      </button>
    {%- endform -%}
  </div>

  <div class="product-card__info">
    {%- assign rating = product.metafields.reviews.rating.value -%}
    {%- if rating -%}
      <div class="product-card__rating" aria-label="Rated {{ rating }} out of 5 stars">
        <span class="stars" style="--rating: {{ rating }};" aria-hidden="true"></span>
        {%- if product.metafields.reviews.rating_count.value -%}
          <span class="product-card__rating-count">({{ product.metafields.reviews.rating_count.value }})</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price">
      <span class="price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="price price--compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
