{%- comment -%}
  snippets/paavai-placeholder.liquid

  Shown where a product has no photograph. 37 of the 59 products currently
  have none, so this is on screen a great deal.

  Shopify's placeholder_svg_tag draws a grey camera icon, which reads as a
  broken image on a jewellery store. This draws the house monogram on ivory
  with a gold rule instead — a photo that hasn't arrived yet, rather than a
  page that failed.

  Deliberately quiet: no "image coming soon" text shouting from every card.

  Usage: {%- render 'paavai-placeholder', title: product.title -%}
{%- endcomment -%}

<span class="pv-ph" role="img" aria-label="{{ title | default: 'Photograph coming soon' | escape }}">
  <svg class="pv-ph__art" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="pvPhGround" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FAF8F5"/>
        <stop offset="100%" stop-color="#F0EBE4"/>
      </linearGradient>
    </defs>

    <rect width="400" height="500" fill="url(#pvPhGround)"/>
    <rect x="26" y="26" width="348" height="448" fill="none" stroke="#D4AF37" stroke-width="1" opacity="0.5"/>

    {%- comment -%} Eight-petal lotus — the motif carried through the catalogue. {%- endcomment -%}
    <g transform="translate(200 214)" fill="none" stroke="#492359" stroke-width="1.1" opacity="0.24">
      <circle r="15"/>
      <ellipse rx="9" ry="34"/>
      <ellipse rx="9" ry="34" transform="rotate(45)"/>
      <ellipse rx="9" ry="34" transform="rotate(90)"/>
      <ellipse rx="9" ry="34" transform="rotate(135)"/>
    </g>

    <text x="200" y="322" text-anchor="middle" font-family="'Bodoni Moda', Didot, Georgia, serif"
          font-size="30" letter-spacing="9" fill="#492359" opacity="0.55">PAAVAI</text>
    <line x1="152" y1="346" x2="248" y2="346" stroke="#D4AF37" stroke-width="1.2" opacity="0.75"/>
    <text x="200" y="374" text-anchor="middle" font-family="Jost, sans-serif"
          font-size="11" letter-spacing="4" fill="#24222A" opacity="0.38">JEWELLERY</text>
  </svg>
</span>
