{%- comment -%}
  snippets/paavai-icon.liquid — inline icon set

  The brief asked for Lucide React. This is a Liquid theme, so there is no
  React runtime to hang a component off — these are the same Lucide glyphs
  drawn inline instead. Same 24x24 grid, same 2px stroke, same rounded caps,
  so the visual language matches.

  Inline rather than a sprite or icon font: they inherit currentColor, cost
  no extra request, and cannot flash unstyled.

  Usage:
    {%- render 'paavai-icon', icon: 'calendar' -%}
    {%- render 'paavai-icon', icon: 'gem', size: 18 -%}
{%- endcomment -%}

{%- liquid
  assign ic = icon | default: 'check'
  assign sz = size | default: 20
-%}

<svg class="pv-icon pv-icon--{{ ic }}" width="{{ sz }}" height="{{ sz }}" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  {%- case ic -%}
    {%- when 'gem' -%}
      <path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M2 9h20"/><path d="m12 21 4-12-4-6-4 6Z"/>
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
    {%- when 'video' -%}
      <path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/>
    {%- when 'store' -%}
      <path d="m3 9 1.5-5h15L21 9"/><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 21v-6h6v6"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'package' -%}
      <path d="m12 2 9 5v10l-9 5-9-5V7Z"/><path d="m3 7 9 5 9-5"/><path d="M12 12v10"/>
    {%- when 'truck' -%}
      <path d="M2 6h11v10H2z"/><path d="M13 9h4.5l2.5 3v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="16.5" cy="18" r="2"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>
    {%- when 'heart' -%}
      <path d="M20.8 5.6a5.5 5.5 0 0 0-7.8 0L12 6.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>
    {%- when 'phone' -%}
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>
    {%- when 'mail' -%}
      <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="6"/><path d="m8.6 14.2-1.4 7 4.8-2.6 4.8 2.6-1.4-7"/>
    {%- when 'sparkles' -%}
      <path d="m12 3 1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8Z"/><path d="m18.5 15.5.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9Z"/>
    {%- when 'shield' -%}
      <path d="M12 21c4.4-1.9 7-5.6 7-10V5.5L12 3 5 5.5V11c0 4.4 2.6 8.1 7 10Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'hammer' -%}
      <path d="m15 12-8.5 8.5a2.1 2.1 0 0 1-3-3L12 9"/><path d="M17.6 6.4 14 2.8l-2.8 2.8 3.6 3.6"/><path d="m14.8 9.2 3.6-3.6 2.8 2.8-3.6 3.6"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 15.3-6.4L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.3 6.4L3 16"/><path d="M3 21v-5h5"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'x' -%}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {%- when 'log-out' -%}
      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>
    {%- else -%}
      <path d="m5 12.5 4.5 4.5L19 7"/>
  {%- endcase -%}
</svg>
