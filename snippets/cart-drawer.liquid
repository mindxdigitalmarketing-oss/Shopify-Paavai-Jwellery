{%- comment -%}
  snippets/cart-drawer.liquid — PAAVAI JEWELLERY Slide-Out AJAX Cart Drawer
  Rendered globally from layout/theme.liquid. Controlled by assets/theme.js (CartDrawer module).
{%- endcomment -%}

<aside
  id="CartDrawer"
  class="cart-drawer"
  aria-hidden="true"
  aria-label="Shopping cart"
  data-free-shipping-enabled="{{ settings.enable_free_shipping_bar | default: true }}"
  data-free-shipping-threshold="{{ settings.free_shipping_threshold | default: 15000 | times: 100 }}">
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title">Your Bag <span data-cart-drawer-count>({{ cart.item_count }})</span></h2>
    <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Close cart">&times;</button>
  </div>

  {%- if settings.enable_free_shipping_bar -%}
    {%- assign fs_threshold_cents = settings.free_shipping_threshold | default: 15000 | times: 100 -%}
    {%- if cart.total_price >= fs_threshold_cents -%}
      {%- assign fs_percent = 100 -%}
    {%- else -%}
      {%- assign fs_percent = cart.total_price | times: 100.0 | divided_by: fs_threshold_cents | times: 100 | round -%}
    {%- endif -%}
    <div class="cart-drawer__shipping-bar" data-shipping-bar{% if cart.item_count == 0 %} hidden{% endif %}>
      <p class="cart-drawer__shipping-bar-msg" data-shipping-bar-msg>
        {%- if cart.total_price >= fs_threshold_cents -%}
          &#10022; You&rsquo;ve unlocked Free Insured Delivery
        {%- else -%}
          Add <strong>{{ fs_threshold_cents | minus: cart.total_price | money }}</strong> more for Free Insured Delivery
        {%- endif -%}
      </p>
      <div class="cart-drawer__shipping-track">
        <div class="cart-drawer__shipping-fill" data-shipping-bar-fill style="width: {{ fs_percent }}%;"></div>
      </div>
    </div>
  {%- endif -%}

  <div class="cart-drawer__body" data-cart-drawer-body>
    {%- if cart.item_count > 0 -%}
      <ul class="cart-drawer__items" data-cart-drawer-items>
        {%- for item in cart.items -%}
          <li class="cart-drawer__item" data-cart-item data-line="{{ forloop.index }}" data-variant-id="{{ item.variant_id }}">
            <a href="{{ item.url }}" class="cart-drawer__item-media">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="90" height="90" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="cart-drawer__item-details">
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="cart-drawer__item-price">{{ item.final_price | money }}</p>

              <div class="cart-drawer__item-qty">
                <button type="button" class="quantity-stepper__btn" data-cart-qty-minus data-line="{{ forloop.index }}" aria-label="Decrease quantity">&minus;</button>
                <input
                  type="number"
                  class="cart-drawer__qty-input"
                  min="0"
                  value="{{ item.quantity }}"
                  data-cart-qty-input
                  data-line="{{ forloop.index }}"
                  aria-label="Quantity for {{ item.product.title }}">
                <button type="button" class="quantity-stepper__btn" data-cart-qty-plus data-line="{{ forloop.index }}" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <button type="button" class="cart-drawer__item-remove" data-cart-remove data-line="{{ forloop.index }}" aria-label="Remove {{ item.product.title }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="cart-drawer__empty" data-cart-drawer-empty>
        <p>Your bag is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-primary" data-cart-drawer-close>Continue Shopping</a>
      </div>
    {%- endif -%}
  </div>

  <div class="cart-drawer__footer" data-cart-drawer-footer{% if cart.item_count == 0 %} hidden{% endif %}>
    <div class="cart-drawer__note">
      <p>&#10022; Complimentary insured shipping &nbsp;&bull;&nbsp; 15-day exchange</p>
    </div>
    <div class="cart-drawer__subtotal">
      <span>Subtotal</span>
      <span data-cart-drawer-subtotal>{{ cart.total_price | money }}</span>
    </div>
    {%- comment -%}
      Price breakdown.

      This DISCLOSES what is already inside the subtotal rather than adding to
      it. Metal value and making charges sum back to the subtotal exactly, so
      this panel can never contradict the number above it or the amount Shopify
      charges at checkout.

      GST is shown as an estimate only. Shopify calculates the real tax at
      checkout from the delivery address, so it sits outside the subtotal and
      is never totalled here. 3% is the Indian GST rate on gold jewellery.
    {%- endcomment -%}
    {%- if cart.item_count > 0 -%}
      {%- assign making_pct = settings.making_charge_percent | default: 14 -%}
      {%- assign making_value = cart.total_price | times: making_pct | divided_by: 100 -%}
      {%- assign metal_value = cart.total_price | minus: making_value -%}
      {%- assign gst_estimate = cart.total_price | times: 3 | divided_by: 100 -%}

      <details class="cart-drawer__breakdown" data-cart-breakdown>
        <summary class="cart-drawer__breakdown-toggle">What&rsquo;s in this price?</summary>
        <dl class="cart-drawer__breakdown-list">
          <div class="cart-drawer__breakdown-row">
            <dt>Metal &amp; stone value</dt>
            <dd>{{ metal_value | money }}</dd>
          </div>
          <div class="cart-drawer__breakdown-row">
            <dt>Making charges <span class="cart-drawer__breakdown-pct">({{ making_pct }}%)</span></dt>
            <dd>{{ making_value | money }}</dd>
          </div>
          <div class="cart-drawer__breakdown-row cart-drawer__breakdown-row--muted">
            <dt>BIS hallmarking</dt>
            <dd>Included</dd>
          </div>
          <div class="cart-drawer__breakdown-row cart-drawer__breakdown-row--muted">
            <dt>GST @ 3% <span class="cart-drawer__breakdown-pct">(estimated)</span></dt>
            <dd>+ {{ gst_estimate | money }}</dd>
          </div>
        </dl>
        <p class="cart-drawer__breakdown-note">
          Making charges are already included in the subtotal. GST is confirmed
          at checkout against your delivery address.
        </p>
      </details>
    {%- endif -%}

    <p class="cart-drawer__shipping-note">Taxes and shipping calculated at checkout.</p>
    <a href="{{ routes.cart_url }}" class="btn btn--outline-primary btn--full">View Bag</a>
    <button type="button" class="btn btn--checkout-gold btn--full" data-checkout-btn>
      <span>Proceed to Checkout</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn--checkout-gold__arrow"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </button>
    <div class="cart-drawer__trust-row" aria-label="Secure checkout">
      <span class="cart-drawer__trust-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
        100% Secure SSL Checkout
      </span>
      <span class="cart-drawer__trust-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="9" r="6"></circle><path d="M8.5 14.5 7 22l5-3 5 3-1.5-7.5"></path></svg>
        Certified Hallmarked Gold
      </span>
    </div>
    <div class="cart-drawer__payment-icons" aria-label="Accepted payment methods">
      <span class="payment-chip">UPI</span>
      <span class="payment-chip">Cards</span>
      <span class="payment-chip">NetBanking</span>
      <span class="payment-chip">EMI</span>
    </div>
  </div>
</aside>

<form data-cart-drawer-template hidden>
  <template id="CartDrawerItemTemplate">
    <li class="cart-drawer__item" data-cart-item>
      <a class="cart-drawer__item-media" data-item-url>
        <img data-item-image width="90" height="90" loading="lazy" alt="">
      </a>
      <div class="cart-drawer__item-details">
        <a class="cart-drawer__item-title" data-item-title data-item-url></a>
        <p class="cart-drawer__item-variant" data-item-variant></p>
        <p class="cart-drawer__item-price" data-item-price></p>
        <div class="cart-drawer__item-qty">
          <button type="button" class="quantity-stepper__btn" data-cart-qty-minus aria-label="Decrease quantity">&minus;</button>
          <input type="number" class="cart-drawer__qty-input" min="0" data-cart-qty-input aria-label="Quantity">
          <button type="button" class="quantity-stepper__btn" data-cart-qty-plus aria-label="Increase quantity">+</button>
        </div>
      </div>
      <button type="button" class="cart-drawer__item-remove" data-cart-remove aria-label="Remove item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
      </button>
    </li>
  </template>
</form>
