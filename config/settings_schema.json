[
  {
    "name": "theme_info",
    "theme_name": "Paavai Jewellery",
    "theme_version": "1.0.0",
    "theme_author": "PAAVAI JEWELLERY",
    "theme_documentation_url": "https://github.com/",
    "theme_support_url": "https://github.com/"
  },
  {
    "name": "Logos & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Header logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "Used when a page has no featured image (1200 x 630px recommended)"
      }
    ]
  },
  {
    "name": "Homepage",
    "settings": [
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero banner image",
        "info": "Recommended size: 2400 x 1350px"
      }
    ]
  },
  {
    "name": "Cart & Shipping",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_free_shipping_bar",
        "label": "Show free shipping progress bar in cart drawer",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (in your store's currency, no symbol)",
        "info": "The cart drawer tells shoppers how much more they need to add to qualify. Set this to match your actual shipping policy.",
        "default": 15000
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL",
        "info": "https://instagram.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL",
        "info": "https://facebook.com/yourstore"
      }
    ]
  },
  {
    "name": "Brand Colors",
    "settings": [
      {
        "type": "header",
        "content": "These pickers drive the live palette. They are read in layout/theme.liquid and cascade through every component."
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Deep Royal Purple",
        "default": "#492359",
        "info": "Header, footer, primary buttons and headings."
      },
      {
        "type": "color",
        "id": "color_plum",
        "label": "Plum",
        "default": "#8B2671",
        "info": "Hover states and sale prices. Keep it dark enough to read on ivory."
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Champagne Gold",
        "default": "#D4AF37"
      },
      {
        "type": "color",
        "id": "color_canvas",
        "label": "Warm Ivory",
        "default": "#FAF8F5"
      }
    ]
  },
  {
    "name": "Gold Rate Board",
    "settings": [
      {
        "type": "paragraph",
        "content": "Leave the 22KT rate at 0 to hide the rate board entirely. Never publish a rate you have not checked today - it is a price claim to your customers."
      },
      {
        "type": "checkbox",
        "id": "enable_gold_rate_bar",
        "label": "Show gold rate board",
        "default": true
      },
      {
        "type": "number",
        "id": "gold_rate_22k",
        "label": "22KT rate (INR per gram)",
        "default": 0
      },
      {
        "type": "number",
        "id": "gold_rate_24k",
        "label": "24KT rate (INR per gram)",
        "default": 0
      },
      {
        "type": "number",
        "id": "gold_rate_18k",
        "label": "18KT rate (INR per gram)",
        "default": 0
      },
      {
        "type": "text",
        "id": "gold_rate_updated",
        "label": "Last updated label",
        "info": "e.g. today, 9:00 AM"
      },
      {
        "type": "range",
        "id": "making_charge_percent",
        "label": "Making charge share of price",
        "unit": "%",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 14,
        "info": "Shown in the cart breakdown as a portion of the price, not added on top."
      }
    ]
  }
]
