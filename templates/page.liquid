{%- comment -%}
  templates/page.liquid — static pages (Our Story, Contact, policies).

  Deliberately narrow: long-form prose set at a comfortable measure rather
  than stretched across the full 1320px container.
{%- endcomment -%}

<div class="static-page container">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li aria-current="page">{{ page.title }}</li>
    </ol>
  </nav>

  <article class="static-page__body">
    <header class="page-header">
      <h1 class="page-header__title">{{ page.title }}</h1>
    </header>

    <div class="rte">
      {{ page.content }}
    </div>
  </article>

</div>
