{%- comment -%}
  templates/index.liquid — PAAVAI JEWELLERY Homepage
  Sections: Hero Banner / Shop By Category (glass cards) / Featured Collection (carousel) / Brand Story / Trust Badges
{%- endcomment -%}

<div class="home-page">

  {%- comment -%} ============ HERO BANNER ============ {%- endcomment -%}
  <section class="hero-banner" aria-label="Featured collection">
    <div class="hero-banner__media">
      {%- if settings.hero_image != blank -%}
        <img
          src="{{ settings.hero_image | image_url: width: 2000 }}"
          srcset="{{ settings.hero_image | image_url: width: 800 }} 800w,
                  {{ settings.hero_image | image_url: width: 1400 }} 1400w,
                  {{ settings.hero_image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          alt="{{ settings.hero_image.alt | default: 'PAAVAI JEWELLERY hero' | escape }}"
          width="{{ settings.hero_image.width }}"
          height="{{ settings.hero_image.height }}"
          loading="eager"
          class="hero-banner__img">
      {%- else -%}
        <img
          src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?q=80&w=2000&auto=format&fit=crop"
          alt="PAAVAI JEWELLERY — heirloom gold and diamond jewellery"
          class="hero-banner__img"
          loading="eager">
      {%- endif -%}
      <div class="hero-banner__scrim"></div>
    </div>

    <div class="hero-banner__content container">
      <p class="hero-banner__eyebrow">The Heirloom Edit &mdash; 2026</p>
      <h1 class="hero-banner__title">Jewellery Woven With <em>Legacy</em></h1>
      <p class="hero-banner__subtitle">Handcrafted gold, diamonds, and South Indian bridal artistry, made to be passed down.</p>
      <div class="hero-banner__actions">
        <a href="/collections/bridal-sets" class="btn btn--gold-outline">Shop Bridal Sets</a>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-light">View All Jewellery</a>
      </div>
    </div>
  </section>

  {%- comment -%} ============ SHOP BY CATEGORY (glassmorphism cards) ============ {%- endcomment -%}
  <section class="category-grid" aria-labelledby="CategoryGridHeading">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Curated Edits</p>
        <h2 id="CategoryGridHeading" class="section-heading__title">Shop By Category</h2>
        <p class="section-heading__subtitle">Four signature edits, each finished by hand.</p>
      </div>

      <div class="category-grid__list">
        <a href="/collections/necklaces" class="category-card">
          <span class="category-card__image-wrap">
            <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=900&auto=format&fit=crop" alt="Necklaces" loading="lazy" width="900" height="1200">
          </span>
          <span class="category-card__title">Necklaces</span>
        </a>
        <a href="/collections/diamond-earrings" class="category-card">
          <span class="category-card__image-wrap">
            <img src="https://images.unsplash.com/photo-1599459183200-59c7687a0275?q=80&w=900&auto=format&fit=crop" alt="Diamond Earrings" loading="lazy" width="900" height="1200">
          </span>
          <span class="category-card__title">Diamond Earrings</span>
        </a>
        <a href="/collections/gold-bangles" class="category-card">
          <span class="category-card__image-wrap">
            <img src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?q=80&w=900&auto=format&fit=crop" alt="Gold Bangles" loading="lazy" width="900" height="1200">
          </span>
          <span class="category-card__title">Gold Bangles</span>
        </a>
        <a href="/collections/bridal-sets" class="category-card">
          <span class="category-card__image-wrap">
            <img src="https://images.unsplash.com/photo-1610694955371-d4a3e0ce4b52?q=80&w=900&auto=format&fit=crop" alt="Bridal Sets" loading="lazy" width="900" height="1200">
          </span>
          <span class="category-card__title">Bridal Sets</span>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ============ FEATURED COLLECTION (carousel / 4-col grid) ============ {%- endcomment -%}
  <section class="featured-collection container" aria-labelledby="FeaturedCollectionHeading">
    <div class="section-heading">
      <p class="section-heading__eyebrow">Most Loved</p>
      <h2 id="FeaturedCollectionHeading" class="section-heading__title">Featured Collection</h2>
      <p class="section-heading__subtitle">Our most gifted pieces, chosen by discerning brides and everyday icons alike.</p>
    </div>

    {%- assign bestsellers_collection = collections['best-sellers'] -%}
    {%- if bestsellers_collection == blank or bestsellers_collection.products.size == 0 -%}
      {%- assign bestsellers_collection = collections.all -%}
    {%- endif -%}

    <div class="featured-carousel" data-featured-carousel>
      <button type="button" class="carousel-nav carousel-nav--prev" data-carousel-prev aria-label="Previous products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="featured-carousel__track" data-carousel-track tabindex="0" aria-label="Featured products, scrollable">
        {%- for product in bestsellers_collection.products limit: 8 -%}
          <div class="product-card featured-carousel__slide">
            <div class="product-card__media">
              <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 700 }}"
                    srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w"
                    sizes="(min-width: 990px) 25vw, 70vw"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}">
                  {%- if product.images.size > 1 -%}
                    <img
                      src="{{ product.images[1] | image_url: width: 700 }}"
                      alt=""
                      loading="lazy"
                      class="product-card__media-hover">
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
                {%- endif -%}
              </a>
              {%- if product.compare_at_price > product.price -%}
                <span class="badge badge--sale">Sale</span>
              {%- endif -%}

              {%- form 'product', product, class: 'product-card__form product-card__quick-add-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  name="add"
                  class="quick-add-btn"
                  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                  {%- if product.selected_or_first_available_variant.available -%}
                    <span>Quick Add</span>
                  {%- else -%}
                    <span>Sold Out</span>
                  {%- endif -%}
                </button>
              {%- endform -%}
            </div>
            <div class="product-card__info">
              {%- assign rating = product.metafields.reviews.rating.value -%}
              {%- if rating -%}
                <div class="product-card__rating" aria-label="Rated {{ rating }} out of 5 stars">
                  <span class="stars" style="--rating: {{ rating }};" aria-hidden="true"></span>
                  {%- if product.metafields.reviews.rating_count.value -%}
                    <span class="product-card__rating-count">({{ product.metafields.reviews.rating_count.value }})</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="product-card__price">
                <span class="price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="price price--compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          {%- comment -%} Fallback sample cards render only when the store has zero products yet {%- endcomment -%}
          {%- for i in (1..8) -%}
            <div class="product-card featured-carousel__slide product-card--placeholder">
              <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}</div>
              <div class="product-card__info">
                <h3 class="product-card__title">Sample Jewellery Piece</h3>
                <div class="product-card__price"><span class="price">{{ 45000 | money }}</span></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <button type="button" class="carousel-nav carousel-nav--next" data-carousel-next aria-label="Next products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div class="best-sellers__cta">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-maroon">Shop All Jewellery</a>
    </div>
  </section>

  {%- comment -%} ============ BRAND STORY ============ {%- endcomment -%}
  <section class="brand-story">
    <div class="container brand-story__grid">
      <div class="brand-story__media">
        <img
          src="https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?q=80&w=1200&auto=format&fit=crop"
          alt="PAAVAI JEWELLERY artisans at work"
          loading="lazy">
      </div>
      <div class="brand-story__content">
        <p class="section-heading__eyebrow">Our Story</p>
        <h2 class="brand-story__title">Crafted By Hand. Worn For Generations.</h2>
        <p class="brand-story__text">
          PAAVAI JEWELLERY was founded on a simple belief: that jewellery should carry meaning, not just shine.
          Every necklace, bangle, and bridal set is hand-finished by master goldsmiths using traditional
          South Indian techniques passed down across generations &mdash; then paired with modern, certified
          craftsmanship so it can be worn every day, not just on your wedding day.
        </p>
        <p class="brand-story__text">
          From temple-inspired motifs to contemporary diamond settings, each piece is designed to become
          part of your story before it becomes part of the next generation's.
        </p>
        <a href="/pages/our-story" class="btn btn--outline-maroon">Read Our Full Story</a>
      </div>
    </div>
  </section>

  {%- comment -%} ============ TRUST BADGES ============ {%- endcomment -%}
  <section class="trust-strip" aria-label="Why shop with us">
    <div class="container trust-strip__grid">
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="9" r="6"></circle><path d="M8.5 14.5 7 22l5-3 5 3-1.5-7.5"></path></svg>
        </span>
        <p>100% Certified Gold</p>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14.5 3.5 3.5 14.5a2 2 0 0 0 0 2.8l3.2 3.2a2 2 0 0 0 2.8 0L20.5 9.5"></path><path d="M12.5 5.5l6 6"></path><path d="M2 22l4-1-1.5-4.5L2 22Z"></path></svg>
        </span>
        <p>Traditional Craftsmanship</p>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
        </span>
        <p>Free Insured Shipping</p>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 12a9 9 0 0 1 15.3-6.4L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15.3 6.4L3 16"></path><path d="M3 21v-5h5"></path></svg>
        </span>
        <p>Easy Returns</p>
      </div>
    </div>
  </section>

</div>
