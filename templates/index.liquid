{%- comment -%}
  templates/index.liquid — PAAVAI JEWELLERY Homepage

  Order: Hero carousel / Gold rate board / Shop by edit / Featured collection /
         Style quiz teaser / Brand story / Trust badges

  LINK POLICY — read before changing any href here.
  This store has exactly one real collection: `necklaces`. The handles this
  page used to link to (bridal-sets, rings, gold-bangles, diamond-earrings)
  do not exist and were returning 404s. Every category link below now uses
  /collections/all/<tag> with tags that are actually present on the catalogue,
  so each tile lands on real products. If you later create proper collections,
  swap these for /collections/<handle> and delete this note.
{%- endcomment -%}

{%- comment -%}
  Source the hero from real products so the slides always show live stock and
  never go stale. Falls back to the whole catalogue if `necklaces` is empty.
{%- endcomment -%}
{%- assign hero_collection = collections['necklaces'] -%}
{%- if hero_collection == blank or hero_collection.products.size == 0 -%}
  {%- assign hero_collection = collections.all -%}
{%- endif -%}

<div class="home-page">

  {%- comment -%} ============ HERO CAROUSEL ============ {%- endcomment -%}
  <section class="hero-carousel" data-hero-carousel aria-roledescription="carousel" aria-label="Featured collections">
    <div class="hero-carousel__viewport" data-hero-viewport>

      {%- assign hero_slides = 0 -%}
      {%- for product in hero_collection.products limit: 12 -%}
        {%- if product.featured_image and hero_slides < 3 -%}
          {%- assign hero_slides = hero_slides | plus: 1 -%}

          {%- comment -%} Frame each slide by what the piece actually is. {%- endcomment -%}
          {%- if product.tags contains 'bridal' -%}
            {%- assign slide_eyebrow = 'The Bridal Edit' -%}
            {%- assign slide_title = 'For The Day<br>Everyone Remembers' -%}
            {%- assign slide_link = '/collections/all/bridal' -%}
          {%- elsif product.tags contains 'temple' -%}
            {%- assign slide_eyebrow = 'Temple & Nakshi' -%}
            {%- assign slide_title = 'Carved The Way<br>It Has Always Been' -%}
            {%- assign slide_link = '/collections/all/temple' -%}
          {%- else -%}
            {%- assign slide_eyebrow = 'The Heirloom Edit' -%}
            {%- assign slide_title = 'Jewellery Woven<br>With <em>Legacy</em>' -%}
            {%- assign slide_link = hero_collection.url | default: routes.all_products_collection_url -%}
          {%- endif -%}

          <article
            class="hero-slide{% if hero_slides == 1 %} is-active{% endif %}"
            data-hero-slide
            role="group"
            aria-roledescription="slide"
            aria-label="Slide {{ hero_slides }}"
            {% if hero_slides != 1 %}aria-hidden="true"{% endif %}>
            <div class="hero-slide__media">
              <img
                src="{{ product.featured_image | image_url: width: 2000 }}"
                srcset="{{ product.featured_image | image_url: width: 800 }} 800w,
                        {{ product.featured_image | image_url: width: 1400 }} 1400w,
                        {{ product.featured_image | image_url: width: 2000 }} 2000w"
                sizes="100vw"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                class="hero-slide__img"
                {% if hero_slides == 1 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              <div class="hero-slide__scrim" aria-hidden="true"></div>
            </div>

            <div class="hero-slide__content container">
              <p class="hero-slide__eyebrow">{{ slide_eyebrow }}</p>
              <h1 class="hero-slide__title">{{ slide_title }}</h1>

              {%- comment -%} Anchor the slide to the actual piece on screen. {%- endcomment -%}
              <p class="hero-slide__product">
                <span class="hero-slide__product-name">{{ product.title }}</span>
                <span class="hero-slide__product-price">{{ product.price | money }}</span>
              </p>

              <div class="hero-slide__actions">
                <a href="{{ slide_link }}" class="btn btn--gold-outline">Explore Collection</a>
                <a href="{{ product.url }}" class="btn btn--outline-light">View This Piece</a>
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Static fallback only when the catalogue has no imagery yet. {%- endcomment -%}
      {%- if hero_slides == 0 -%}
        <article class="hero-slide is-active" data-hero-slide role="group" aria-label="Slide 1">
          <div class="hero-slide__media">
            <img
              src="{{ settings.hero_image | image_url: width: 2000 | default: 'https://images.unsplash.com/photo-1611591437281-460bfbe1220a?q=80&w=2000&auto=format&fit=crop' }}"
              alt="PAAVAI JEWELLERY — heirloom gold and diamond jewellery"
              class="hero-slide__img" loading="eager">
            <div class="hero-slide__scrim" aria-hidden="true"></div>
          </div>
          <div class="hero-slide__content container">
            <p class="hero-slide__eyebrow">The Heirloom Edit</p>
            <h1 class="hero-slide__title">Jewellery Woven<br>With <em>Legacy</em></h1>
            <div class="hero-slide__actions">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--gold-outline">Explore Collection</a>
            </div>
          </div>
        </article>
      {%- endif -%}
    </div>

    {%- if hero_slides > 1 -%}
      <div class="hero-carousel__controls container">
        <button type="button" class="hero-carousel__arrow" data-hero-prev aria-label="Previous slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <div class="hero-carousel__dots" role="tablist" aria-label="Choose slide">
          {%- for i in (1..hero_slides) -%}
            <button type="button" class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}"
                    data-hero-dot="{{ forloop.index0 }}" role="tab"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="Slide {{ forloop.index }}">
              <span class="hero-carousel__dot-fill"></span>
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="hero-carousel__arrow" data-hero-next aria-label="Next slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    {%- endif -%}
  </section>

  {%- comment -%} ============ GOLD RATE BOARD ============ {%- endcomment -%}
  {%- render 'gold-rate-bar' -%}

  {%- comment -%} ============ SHOP BY EDIT ============ {%- endcomment -%}
  <section class="category-grid" aria-labelledby="CategoryGridHeading">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Curated Edits</p>
        <h2 id="CategoryGridHeading" class="section-heading__title">Shop By Edit</h2>
        <p class="section-heading__subtitle">Five houses of craft, each finished by hand.</p>
      </div>

      {%- comment -%}
        Grouped by CRAFT rather than by product type. The catalogue is entirely
        necklaces today, so "Bangles / Earrings / Rings" tiles would have led to
        empty pages. These five tags all resolve to real, stocked pieces.
      {%- endcomment -%}
      {%- assign edits = 'bridal,temple,jadau,victorian,choker' | split: ',' -%}
      {%- assign edit_titles = 'Bridal Harams,Temple & Nakshi,Jadau & Polki,Victorian & Antique,Chokers' | split: ',' -%}

      <div class="category-grid__list">
        {%- for tag in edits -%}
          {%- assign tile_image = blank -%}
          {%- for product in hero_collection.products -%}
            {%- if product.tags contains tag and product.featured_image -%}
              {%- assign tile_image = product.featured_image -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          <a href="/collections/all/{{ tag }}" class="category-card">
            <span class="category-card__image-wrap">
              {%- if tile_image != blank -%}
                <img src="{{ tile_image | image_url: width: 900 }}"
                     alt="{{ edit_titles[forloop.index0] }}"
                     loading="lazy" width="900" height="1200" class="category-card__img">
              {%- else -%}
                <span class="category-card__img category-card__img--empty" aria-hidden="true"></span>
              {%- endif -%}
              <span class="category-card__overlay" aria-hidden="true"></span>
              <span class="category-card__title">{{ edit_titles[forloop.index0] }}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ FEATURED COLLECTION ============ {%- endcomment -%}
  <section class="featured-collection container" aria-labelledby="FeaturedCollectionHeading">
    <div class="section-heading">
      <p class="section-heading__eyebrow">Most Loved</p>
      <h2 id="FeaturedCollectionHeading" class="section-heading__title">Featured Collection</h2>
      <p class="section-heading__subtitle">Our most gifted pieces, chosen by discerning brides and everyday icons alike.</p>
    </div>

    {%- assign bestsellers_collection = collections['best-sellers'] -%}
    {%- if bestsellers_collection == blank or bestsellers_collection.products.size == 0 -%}
      {%- assign bestsellers_collection = hero_collection -%}
    {%- endif -%}

    <div class="featured-carousel" data-featured-carousel>
      <button type="button" class="carousel-nav carousel-nav--prev" data-carousel-prev aria-label="Previous products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="featured-carousel__track" data-carousel-track tabindex="0" aria-label="Featured products, scrollable">
        {%- for product in bestsellers_collection.products limit: 8 -%}
          <div class="featured-carousel__slide">
            {%- render 'product-card', product: product -%}
          </div>
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="product-card featured-carousel__slide product-card--placeholder">
              <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}</div>
              <div class="product-card__info">
                <h3 class="product-card__title">Sample Jewellery Piece</h3>
                <div class="product-card__price"><span class="price">{{ 45000 | money }}</span></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <button type="button" class="carousel-nav carousel-nav--next" data-carousel-next aria-label="Next products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div class="best-sellers__cta">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-primary">Shop All Jewellery</a>
    </div>
  </section>

  {%- comment -%}
    ============ EXQUISITE NECKLACES COLLECTION ============

    Four necklace houses. Each tile resolves to a real collection when one
    exists with that handle, and otherwise falls back to the tag route —
    /collections/all/<tag> — which is how the rest of this homepage links,
    because only the `necklaces` collection exists today.

    Tile art comes from the collection image, then the first product's
    image, then the house monogram. No tile can render blank.
  {%- endcomment -%}
  <section class="necklace-edit" aria-labelledby="NecklaceEditHeading">
    <div class="container">
      <header class="necklace-edit__head">
        <p class="pv-eyebrow">The necklace houses</p>
        <h2 id="NecklaceEditHeading" class="necklace-edit__title">Exquisite Necklaces</h2>
      </header>

      {%- assign nk_handles = 'chokers,temple-necklaces,bridal-haram,solitaire-sets' | split: ',' -%}
      {%- assign nk_tags = 'choker,temple,bridal,solitaire' | split: ',' -%}
      {%- assign nk_names = 'Chokers,Temple Necklaces,Bridal Haram,Solitaire Sets' | split: ',' -%}

      <ul class="necklace-grid">
        {%- for handle in nk_handles -%}
          {%- liquid
            assign i = forloop.index0
            assign tag = nk_tags[i]
            assign nk = collections[handle]

            if nk != blank and nk.all_products_count > 0
              assign nk_url = nk.url
              assign nk_count = nk.all_products_count
              assign nk_image = nk.featured_image
            else
              assign nk_url = '/collections/all/' | append: tag
              assign nk_count = 0
              assign nk_image = blank
            endif

            # No collection for this house yet — find a representative
            # image and a count from the tag instead.
            if nk_image == blank
              for p in collections.all.products
                if p.tags contains tag
                  assign nk_count = nk_count | plus: 1
                  if nk_image == blank and p.featured_image
                    assign nk_image = p.featured_image
                  endif
                endif
              endfor
            endif
          -%}

          <li>
            <a class="necklace-tile" href="{{ nk_url }}">
              {%- if nk_image != blank -%}
                <img src="{{ nk_image | image_url: width: 700 }}"
                     alt="" loading="lazy" width="350" height="466">
              {%- else -%}
                {%- render 'paavai-placeholder', title: nk_names[i] -%}
              {%- endif -%}
              <span class="necklace-tile__veil" aria-hidden="true"></span>
              <span class="necklace-tile__body">
                <span class="necklace-tile__name">{{ nk_names[i] }}</span>
                {%- if nk_count > 0 -%}
                  <span class="necklace-tile__count">
                    {{ nk_count }} {% if nk_count == 1 %}piece{% else %}pieces{% endif %}
                  </span>
                {%- else -%}
                  <span class="necklace-tile__count">Explore</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%}
    ============ TRY AT HOME ============

    Links to the consultation page rather than promising a booking here —
    there is no scheduling backend, and a second entry point that behaved
    differently from the real form would only confuse.
  {%- endcomment -%}
  <section class="tryhome" aria-labelledby="TryHomeHeading">
    <div class="container tryhome__inner">
      <div>
        <p class="pv-eyebrow">Try at Home</p>
        <h2 id="TryHomeHeading" class="tryhome__title">
          See it on you,<br><em>before you decide</em>
        </h2>
        <p class="tryhome__text">
          A haram photographs beautifully and still sits differently on every neck.
          Book a consultation and we will bring a selection to you — or walk you
          through them on video if that is easier.
        </p>

        <div class="tryhome__actions">
          <a href="/pages/contact" class="btn btn--gold">Book a consultation</a>
          <a href="/pages/our-story" class="btn btn--outline-light">Our story</a>
        </div>

        <ul class="tryhome__chips">
          <li class="pv-glass">{%- render 'paavai-icon', icon: 'shield', size: 14 -%} Fully insured</li>
          <li class="pv-glass">{%- render 'paavai-icon', icon: 'gem', size: 14 -%} No obligation</li>
          <li class="pv-glass">{%- render 'paavai-icon', icon: 'map-pin', size: 14 -%} Across Tamil Nadu</li>
        </ul>
      </div>

      <ol class="tryhome__steps">
        <li class="tryhome__step">
          <div>
            <p class="tryhome__step-title">Tell us what you are after</p>
            <p class="tryhome__step-text">Occasion, budget and the style you have in mind.</p>
          </div>
        </li>
        <li class="tryhome__step">
          <div>
            <p class="tryhome__step-title">Pick a time</p>
            <p class="tryhome__step-text">In-store at the flagship, or a video consultation.</p>
          </div>
        </li>
        <li class="tryhome__step">
          <div>
            <p class="tryhome__step-title">Try, then decide</p>
            <p class="tryhome__step-text">Live gold rates and itemised making charges, in front of you.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {%- comment -%} ============ STYLE QUIZ TEASER ============ {%- endcomment -%}
  <section class="quiz-teaser" aria-labelledby="QuizTeaserHeading">
    <div class="container quiz-teaser__inner">
      <div class="quiz-teaser__content">
        <p class="section-heading__eyebrow">Not sure where to start?</p>
        <h2 id="QuizTeaserHeading" class="quiz-teaser__title">Find Your Perfect Match<br>In 3 Questions</h2>
        <p class="quiz-teaser__text">
          Tell us the occasion, the metal, and the stones. We&rsquo;ll pull the
          pieces from our collection that actually fit &mdash; no guesswork.
        </p>
        <button type="button" class="btn btn--gold" data-style-quiz-open>Take The Style Quiz</button>
      </div>
      <div class="quiz-teaser__decor" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="0.6">
          <circle cx="100" cy="100" r="78"></circle>
          <circle cx="100" cy="100" r="60"></circle>
          <circle cx="100" cy="100" r="42"></circle>
          {%- comment -%} Eight-petal lotus — the motif carried through the catalogue. {%- endcomment -%}
          {%- for i in (0..7) -%}
            <ellipse cx="100" cy="100" rx="18" ry="52" transform="rotate({{ i | times: 45 }} 100 100)"></ellipse>
          {%- endfor -%}
        </svg>
      </div>
    </div>
  </section>

  {%- comment -%} ============ BRAND STORY ============ {%- endcomment -%}
  <section class="brand-story">
    <div class="container brand-story__grid">
      <div class="brand-story__media">
        <img
          src="https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?q=80&w=1200&auto=format&fit=crop"
          alt="PAAVAI JEWELLERY artisans at work"
          loading="lazy">
      </div>
      <div class="brand-story__content">
        <p class="section-heading__eyebrow">Our Story</p>
        <h2 class="brand-story__title">Crafted By Hand. Worn For Generations.</h2>
        <p class="brand-story__text">
          PAAVAI JEWELLERY was founded on a simple belief: that jewellery should carry meaning, not just shine.
          Every necklace, haram, and bridal set is hand-finished by master goldsmiths using traditional
          South Indian techniques passed down across generations &mdash; then paired with modern, certified
          craftsmanship so it can be worn every day, not just on your wedding day.
        </p>
        <p class="brand-story__text">
          From temple-inspired motifs to contemporary diamond settings, each piece is designed to become
          part of your story before it becomes part of the next generation&rsquo;s.
        </p>
        <a href="/pages/our-story" class="btn btn--outline-primary">Read Our Full Story</a>
      </div>
    </div>
  </section>

  {%- comment -%} ============ TRUST BADGES ============ {%- endcomment -%}
  <section class="trust-strip" aria-label="Why shop with us">
    <div class="container trust-strip__grid">
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="9" r="6"></circle><path d="M8.5 14.5 7 22l5-3 5 3-1.5-7.5"></path></svg>
        </span>
        <p>100% BIS Hallmarked Gold</p>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
        </span>
        <p>Insured Express Shipping Across India</p>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 12a9 9 0 0 1 15.3-6.4L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15.3 6.4L3 16"></path><path d="M3 21v-5h5"></path></svg>
        </span>
        <p>Easy 15-Day Returns &amp; Exchange</p>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </span>
        <p>Lifetime Buyback Guarantee</p>
      </div>
    </div>
  </section>

</div>
