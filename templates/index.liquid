{%- comment -%}
  templates/index.liquid — RS1 Homepage

  Structure follows the familiar "one hero product" direct-to-consumer layout:
  Hero / Trust strip / What is RS1 / How it works / Featured products /
  Ways to buy / Ingredients / Reviews / FAQ / Final call to action.

  All copy here is original and deliberately free of health claims. Check every
  line against what RS1 really offers (shipping, returns, subscription terms)
  before this goes live — see HANDOVER notes in the pull request.
{%- endcomment -%}

<div class="home-page rs1-home">

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <section class="rs1-hero" aria-label="RS1">
    <div class="container rs1-hero__grid">
      <div class="rs1-hero__copy">
        <p class="rs1-eyebrow">Your daily drink</p>
        <h1 class="rs1-hero__title">One simple habit.<br><span class="rs1-accent">Every single day.</span></h1>
        <p class="rs1-hero__lead">RS1 is a daily drink built around a short, clear ingredient list and a routine that takes less than a minute. Choose a plan, set your schedule, and we deliver.</p>
        <div class="rs1-hero__actions">
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--blue btn--large">Start with RS1</a>
          <a href="#how-it-works" class="btn btn--outline-navy btn--large">See how it works</a>
        </div>
        <ul class="rs1-hero__points">
          <li>Subscribe and manage your plan any time</li>
          <li>Secure checkout</li>
          <li>Order tracking</li>
        </ul>
      </div>

      <div class="rs1-hero__visual" aria-hidden="true">
        <div class="rs1-pouch">
          <span class="rs1-pouch__brand">RS1</span>
          <span class="rs1-pouch__tag">Daily drink</span>
        </div>
        <span class="rs1-chip rs1-chip--a">Simple ingredients</span>
        <span class="rs1-chip rs1-chip--b">Your schedule</span>
        <span class="rs1-chip rs1-chip--c">Delivered</span>
      </div>
    </div>
  </section>

  {%- comment -%} ============ TRUST STRIP ============ {%- endcomment -%}
  <section class="rs1-trust" aria-label="Why shop with us">
    <div class="container rs1-trust__grid">
      <p><span aria-hidden="true">&#10022;</span> Secure checkout</p>
      <p><span aria-hidden="true">&#10022;</span> Delivered to your door</p>
      <p><span aria-hidden="true">&#10022;</span> Order tracking</p>
      <p><span aria-hidden="true">&#10022;</span> Support when you need it</p>
    </div>
  </section>

  {%- comment -%} ============ WHAT IS RS1 ============ {%- endcomment -%}
  <section class="rs1-section" aria-labelledby="WhatHeading">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">What is RS1</p>
        <h2 id="WhatHeading" class="section-heading__title">Made to fit into your morning</h2>
        <p class="section-heading__subtitle">No long routine, no guesswork. Just one drink, prepared the same way each day.</p>
      </div>
      <div class="rs1-cards">
        <article class="rs1-card">
          <span class="rs1-card__num">01</span>
          <h3>Simple by design</h3>
          <p>A short, readable ingredient list, so you know what you are drinking.</p>
        </article>
        <article class="rs1-card">
          <span class="rs1-card__num">02</span>
          <h3>Easy to keep up</h3>
          <p>Prepare it in seconds, at home or on the go, and make it part of your day.</p>
        </article>
        <article class="rs1-card">
          <span class="rs1-card__num">03</span>
          <h3>Delivered on your terms</h3>
          <p>Pick how often it arrives and change or pause your plan whenever you like.</p>
        </article>
      </div>
    </div>
  </section>

  {%- comment -%} ============ HOW IT WORKS ============ {%- endcomment -%}
  <section class="rs1-section rs1-section--navy" id="how-it-works" aria-labelledby="HowHeading">
    <div class="container">
      <div class="section-heading section-heading--light">
        <p class="section-heading__eyebrow">How it works</p>
        <h2 id="HowHeading" class="section-heading__title">Three steps, once a day</h2>
      </div>
      <ol class="rs1-steps">
        <li class="rs1-step"><span class="rs1-step__num">1</span><h3>Choose your plan</h3><p>Pick a one-time order or a subscription that matches how often you want it.</p></li>
        <li class="rs1-step"><span class="rs1-step__num">2</span><h3>Prepare your drink</h3><p>Follow the directions on the pack. It takes under a minute.</p></li>
        <li class="rs1-step"><span class="rs1-step__num">3</span><h3>Keep your routine</h3><p>Your next delivery arrives on your schedule, so you never have to remember to reorder.</p></li>
      </ol>
    </div>
  </section>

  {%- comment -%} ============ FEATURED PRODUCTS ============ {%- endcomment -%}
  <section class="featured-collection container" aria-labelledby="FeaturedCollectionHeading">
    <div class="section-heading">
      <p class="section-heading__eyebrow">Shop</p>
      <h2 id="FeaturedCollectionHeading" class="section-heading__title">Start your routine</h2>
      <p class="section-heading__subtitle">Choose what works for you.</p>
    </div>

    {%- assign featured_collection = collections['best-sellers'] -%}
    {%- if featured_collection == blank or featured_collection.products.size == 0 -%}
      {%- assign featured_collection = collections.all -%}
    {%- endif -%}

    <div class="featured-carousel" data-featured-carousel>
      <button type="button" class="carousel-nav carousel-nav--prev" data-carousel-prev aria-label="Previous products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="featured-carousel__track" data-carousel-track tabindex="0" aria-label="Products, scrollable">
        {%- for product in featured_collection.products limit: 8 -%}
          {%- render 'product-card', product: product, extra_class: 'featured-carousel__slide', eager: forloop.first -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="product-card featured-carousel__slide product-card--placeholder">
              <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}</div>
              <div class="product-card__info">
                <h3 class="product-card__title">RS1</h3>
                <div class="product-card__price"><span class="price">{{ 0 | money }}</span></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <button type="button" class="carousel-nav carousel-nav--next" data-carousel-next aria-label="Next products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div class="best-sellers__cta">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-navy">Shop all</a>
    </div>
  </section>

  {%- comment -%} ============ WAYS TO BUY ============ {%- endcomment -%}
  <section class="rs1-section" aria-labelledby="BuyHeading">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Ways to buy</p>
        <h2 id="BuyHeading" class="section-heading__title">Subscribe, or order once</h2>
      </div>
      <div class="rs1-buy">
        <article class="rs1-buy__card rs1-buy__card--featured">
          <p class="rs1-buy__label">Subscription</p>
          <h3>Delivered on a schedule</h3>
          <ul>
            <li>Choose how often it arrives</li>
            <li>Skip, pause or cancel from your account</li>
            <li>Never run out</li>
          </ul>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--blue">Choose a subscription</a>
        </article>
        <article class="rs1-buy__card">
          <p class="rs1-buy__label">One-time order</p>
          <h3>Try it first</h3>
          <ul>
            <li>No commitment</li>
            <li>Same product, same quality</li>
            <li>Switch to a subscription later</li>
          </ul>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-navy">Order once</a>
        </article>
      </div>
    </div>
  </section>

  {%- comment -%} ============ INGREDIENTS ============ {%- endcomment -%}
  <section class="rs1-section rs1-section--mist-dark" id="ingredients" aria-labelledby="IngHeading">
    <div class="container rs1-split">
      <div>
        <p class="section-heading__eyebrow">Ingredients</p>
        <h2 id="IngHeading" class="rs1-split__title">Nothing hidden</h2>
        <p class="rs1-split__text">The full ingredient list and nutrition panel for every product is on its product page and on the pack, so you can read exactly what is in it before you order.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--navy">See the product details</a>
      </div>
      <div class="rs1-panel" aria-hidden="true">
        <p class="rs1-panel__title">Supplement facts</p>
        <p class="rs1-panel__row"><span>Serving size</span><span>On the pack</span></p>
        <p class="rs1-panel__row"><span>Ingredients</span><span>Listed in full</span></p>
        <p class="rs1-panel__row"><span>Allergens</span><span>Clearly marked</span></p>
      </div>
    </div>
  </section>

  {%- comment -%} ============ REVIEWS (Judge.me) ============ {%- endcomment -%}
  <section class="rs1-section" id="reviews" aria-labelledby="ReviewsHeading">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Reviews</p>
        <h2 id="ReviewsHeading" class="section-heading__title">What customers say</h2>
      </div>
      {%- comment -%} Judge.me fills this in with real, verified reviews once the app is enabled. {%- endcomment -%}
      <div class="jdgm-widget jdgm-all-reviews-widget"></div>
    </div>
  </section>

  {%- comment -%} ============ FAQ ============ {%- endcomment -%}
  <section class="rs1-section rs1-section--mist-dark" id="faq" aria-labelledby="FaqHeading">
    <div class="container rs1-faq">
      <div class="section-heading">
        <p class="section-heading__eyebrow">FAQ</p>
        <h2 id="FaqHeading" class="section-heading__title">Questions, answered</h2>
      </div>
      <details class="rs1-faq__item"><summary>How do I order?</summary><p>Choose a product, pick a one-time order or a subscription, and check out securely.</p></details>
      <details class="rs1-faq__item"><summary>Can I change my subscription?</summary><p>Yes. Sign in to your account to change the schedule, skip a delivery or cancel.</p></details>
      <details class="rs1-faq__item"><summary>Where can I read the ingredients?</summary><p>On each product page and on the pack.</p></details>
      <details class="rs1-faq__item"><summary>How do I get help with an order?</summary><p>Contact us through the <a href="/pages/contact-us">contact page</a> and we will get back to you.</p></details>
    </div>
  </section>

  {%- comment -%} ============ FINAL CTA ============ {%- endcomment -%}
  <section class="rs1-final">
    <div class="container rs1-final__inner">
      <h2>Ready to start your routine?</h2>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--blue btn--large">Start with RS1</a>
    </div>
  </section>

</div>
