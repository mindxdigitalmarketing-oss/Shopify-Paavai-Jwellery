{%- comment -%}
  templates/customers/reset_password.liquid — set a new password from an email link
{%- endcomment -%}

<div class="auth-page container">
  <div class="auth-card">
    <div class="auth-card__head">
      <h1 class="auth-card__title">Choose a new password</h1>
    </div>

    {%- form 'reset_customer_password', class: 'auth-form' -%}
      {%- if form.errors -%}
        <div class="form-banner form-banner--error" role="alert">
          {%- render 'paavai-icon', icon: 'x', size: 18 -%}
          <ul class="form-banner__list">
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} — {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <label class="form-field">
        <span class="form-field__label">New password</span>
        <input type="password" name="customer[password]" required autocomplete="new-password">
      </label>

      <label class="form-field">
        <span class="form-field__label">Confirm password</span>
        <input type="password" name="customer[password_confirmation]" required autocomplete="new-password">
      </label>

      <button type="submit" class="btn btn--primary btn--full btn--large">Save password</button>
    {%- endform -%}
  </div>
</div>
