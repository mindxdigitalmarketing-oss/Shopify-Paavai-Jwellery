{%- comment -%}
  templates/customers/activate_account.liquid — accept an invitation
{%- endcomment -%}

<div class="auth-page container">
  <div class="auth-card">
    <div class="auth-card__head">
      <p class="pv-eyebrow">Paavai Circle</p>
      <h1 class="auth-card__title">Activate your account</h1>
      <p class="auth-card__sub">Set a password to finish setting things up.</p>
    </div>

    {%- form 'activate_customer_password', class: 'auth-form' -%}
      {%- if form.errors -%}
        <div class="form-banner form-banner--error" role="alert">
          {%- render 'paavai-icon', icon: 'x', size: 18 -%}
          <ul class="form-banner__list">
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} — {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <label class="form-field">
        <span class="form-field__label">Password</span>
        <input type="password" name="customer[password]" required autocomplete="new-password">
      </label>

      <label class="form-field">
        <span class="form-field__label">Confirm password</span>
        <input type="password" name="customer[password_confirmation]" required autocomplete="new-password">
      </label>

      <button type="submit" class="btn btn--primary btn--full btn--large">Activate account</button>
      <button type="submit" name="decline" class="btn btn--outline-primary btn--full">Decline invitation</button>
    {%- endform -%}
  </div>
</div>
